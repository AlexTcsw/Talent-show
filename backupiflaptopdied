import customtkinter as ctk
import os
import sys
import ctypes

# 1. IDENTITY FIX (Tells Windows: "I am Code Club, not just Python")
try:
    myappid = 'centerburg.codeclub.talentshow.1' 
    ctypes.windll.shell32.SetCurrentProcessExplicitAppUserModelID(myappid)
except:
    pass

# 2. PATH FIX (Tells the EXE: "Look inside yourself for the cat")
def resource_path(relative_path):
    try:
        base_path = sys._MEIPASS
    except Exception:
        base_path = os.path.abspath(".")
    return os.path.join(base_path, relative_path)

# 3. JOKE DATABASE
jokes = [
    {"q": "Why did the laptop go to the doctor?", "a": "Because it had a virus!"},
    {"q": "Why do programmers prefer dark mode?", "a": "Because light attracts bugs."},
    {"q": "What do you call a fake noodle?", "a": "An Impasta!"},
    {"q": "How many programmers does it take to change a lightbulb?", "a": "None. It's a hardware problem."}
]
current_joke = 0

# 4. FUNCTIONS
def show_next_joke():
    global current_joke
    current_joke = (current_joke + 1) % len(jokes) 
    question_label.configure(text=jokes[current_joke]["q"])
    answer_label.configure(text="Click to reveal...")

def reveal_answer():
    answer_label.configure(text=jokes[current_joke]["a"])

def show_credits():
    credits_window = ctk.CTkToplevel(app)
    credits_window.title("The Squad")
    credits_window.geometry("300x280")
    credits_window.attributes("-topmost", True) 

    ctk.CTkLabel(credits_window, text="CODE CLUB TEAM", font=("Arial", 16, "bold")).pack(pady=10)
    ctk.CTkLabel(credits_window, text="Alex: Lead Developer").pack()
    ctk.CTkLabel(credits_window, text="Wyatt: The Designer").pack()
    ctk.CTkLabel(credits_window, text="Daymein: Creative Director").pack()
    ctk.CTkButton(credits_window, text="Close", command=credits_window.destroy).pack(pady=15)

# 5. MAIN GUI SETUP
ctk.set_appearance_mode("dark") 
app = ctk.CTk()
app.title("Code Club: Talent Show Edition")
app.geometry("600x500")

# Set the Icon using the Path Fix
try:
    app.iconbitmap(resource_path("cat.ico"))
except:
    print("Icon not found, but keep going!")

# 6. UI ELEMENTS (Make sure these are inside the app setup)
question_label = ctk.CTkLabel(app, text=jokes[0]["q"], font=("Arial", 22, "bold"), wraplength=500)
question_label.pack(pady=30)

answer_label = ctk.CTkLabel(app, text="Click to reveal...", font=("Arial", 20))
answer_label.pack(pady=10)

reveal_btn = ctk.CTkButton(app, text="Reveal Answer", command=reveal_answer, fg_color="green", hover_color="#006400")
reveal_btn.pack(pady=10)

next_btn = ctk.CTkButton(app, text="Next Joke", command=show_next_joke)
next_btn.pack(pady=10)

credits_btn = ctk.CTkButton(app, text="Meet the Team", command=show_credits, fg_color="purple", hover_color="#4B0082")
credits_btn.pack(pady=30)

# 7. RUN THE APP
app.mainloop()
